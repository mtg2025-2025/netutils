FROM python:3.12-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y \
    curl \
    git \
    bash \
    ca-certificates \
    nano \
    procps \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry, the package manager Netutils uses (same version as the project's own Dockerfile)
ENV POETRY_HOME=/opt/poetry
RUN curl -sSL https://install.python-poetry.org | POETRY_VERSION=2.1.3 python3 - \
    && ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

# Install Netutils, its dependencies and dev tools (pytest, ruff, pylint, mypy...)
# Only the project's settings files are copied in, with a placeholder for the code.
# The real code is mounted at /workspace when the container runs.
COPY pyproject.toml poetry.lock README.md /workspace/
RUN mkdir -p /workspace/netutils && touch /workspace/netutils/__init__.py \
    && poetry config virtualenvs.create false \
    && poetry install --with dev --all-extras --no-interaction \
    && rm -rf /workspace/* /root/.cache/pypoetry

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code

# Make Git ignore Windows line endings, so files checked out on Windows don't show as changed
RUN git config --global core.autocrlf true

# Claude Code configuration: default settings + status line
RUN mkdir -p /root/.claude
COPY agent/settings.json /root/.claude/settings.json
COPY agent/statusline.sh /root/.claude/statusline.sh
RUN sed -i 's/\r$//' /root/.claude/statusline.sh && chmod +x /root/.claude/statusline.sh

# Copy entrypoint script (sed removes Windows line endings so Linux can run it)
COPY agent/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh && chmod +x /usr/local/bin/docker-entrypoint.sh

# Student shell quality-of-life improvements
RUN echo 'export PS1="ai-course:\\w# "' >> /root/.bashrc && \
    echo 'alias ll="ls -alF"' >> /root/.bashrc && \
    echo 'alias la="ls -A"' >> /root/.bashrc && \
    echo 'alias l="ls -CF"' >> /root/.bashrc && \
    echo 'alias python="python3"' >> /root/.bashrc && \
    echo 'alias pip="pip3"' >> /root/.bashrc

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/bin/bash"]